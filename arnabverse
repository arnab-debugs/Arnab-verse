<script>
  // ---------- intro / loading sequence ----------
  (function(){
    const statuses = [
      'Opening the doors…',
      'Dusting the exhibits…',
      'Hanging the placards…',
      'Tuning the soundtrack…',
      'Polishing the trophies…',
      'Almost ready…'
    ];
    const fill = document.getElementById('introFill');
    const pct = document.getElementById('introPct');
    const statusEl = document.getElementById('introStatus');
    const introScreen = document.getElementById('introScreen');
    const doorL = document.getElementById('introDoorL');
    const doorR = document.getElementById('introDoorR');

    let progress = 0;
    let statusIdx = 0;
    statusEl.textContent = statuses[0];

    const statusTimer = setInterval(()=>{
      statusIdx = Math.min(statusIdx+1, statuses.length-1);
      statusEl.textContent = statuses[statusIdx];
    }, 480);

    const progressTimer = setInterval(()=>{
      progress += Math.random()*14 + 6;
      if(progress >= 100){
        progress = 100;
        clearInterval(progressTimer);
        clearInterval(statusTimer);
        statusEl.textContent = 'Welcome.';
        setTimeout(revealMuseum, 380);
      }
      fill.style.width = progress + '%';
      pct.textContent = Math.floor(progress) + '%';
    }, 220);

    function revealMuseum(){
      introScreen.classList.add('hidden');
      doorL.classList.add('open');
      doorR.classList.add('open');
      setTimeout(()=>{
        document.body.classList.remove('intro-active');
        doorL.remove();
        doorR.remove();
        introScreen.remove();
      }, 1100);
    }
  })();

  // ---------- living milky way starfield (v2: denser, textured, layered) ----------
  const canvas = document.getElementById('bgCanvas');
  const ctx = canvas.getContext('2d');
  let w,h,stars=[],heroStars=[],embers=[],dustBand=[],galaxyBand=[],shootingStar=null;
  function resize(){
    w = canvas.width = window.innerWidth;
    h = canvas.height = document.documentElement.scrollHeight;
  }

  // diagonal galaxy band geometry — a streak running across the sky like the real Milky Way
  function bandPoint(t){
    // t: 0..1 along the band's length, returns {x,y} with band running diagonally
    const x = -w*0.25 + t*(w*1.5);
    const y = h*0.08 + t*(h*0.55) + Math.sin(t*Math.PI*1.4)*h*0.06;
    return {x,y};
  }

  function initField(){
    // background faint scatter — the deep, distant layer
    stars = [];
    const starCount = Math.min(520, Math.floor((w*h)/3200));
    for(let i=0;i<starCount;i++){
      stars.push({
        x: Math.random()*w, y: Math.random()*h,
        r: Math.random()*1.1+0.2,
        baseA: Math.random()*0.45+0.15,
        phase: Math.random()*Math.PI*2,
        speed: Math.random()*0.02+0.006,
        tint: Math.random()>0.88 ? '34,211,238' : (Math.random()>0.76 ? '139,92,246' : '255,255,255')
      });
    }

    // bright "hero" stars — fewer, bigger, with a subtle cross-flare
    heroStars = [];
    const heroCount = Math.min(14, Math.floor(w/110));
    for(let i=0;i<heroCount;i++){
      heroStars.push({
        x: Math.random()*w, y: Math.random()*h,
        r: Math.random()*1.4+1.6,
        baseA: Math.random()*0.3+0.55,
        phase: Math.random()*Math.PI*2,
        speed: Math.random()*0.012+0.004,
        tint: Math.random()>0.6 ? '255,255,255' : (Math.random()>0.5 ? '245,200,76' : '34,211,238')
      });
    }

    // galaxy band — clustered stars + dust following a diagonal sweep, like the real Milky Way core
    galaxyBand = [];
    const bandSamples = 140;
    for(let i=0;i<bandSamples;i++){
      const t = Math.random();
      const base = bandPoint(t);
      const spread = (Math.random()-0.5) * (h*0.09) * (0.4+Math.random());
      const perpAngle = Math.PI/2 + Math.atan2(0.55*h, 1.5*w);
      galaxyBand.push({
        x: base.x + Math.cos(perpAngle)*spread,
        y: base.y + Math.sin(perpAngle)*spread,
        r: Math.random()*1.1+0.3,
        baseA: Math.random()*0.5+0.2,
        phase: Math.random()*Math.PI*2,
        speed: Math.random()*0.018+0.006,
        tint: Math.random()>0.7 ? '139,92,246' : (Math.random()>0.45 ? '255,255,255' : '34,211,238')
      });
    }

    // soft nebula glow clusters along the band — the "textured haze"
    dustBand = [];
    const dustCount = Math.min(48, Math.floor(w/22));
    for(let i=0;i<dustCount;i++){
      const t = Math.random();
      const base = bandPoint(t);
      dustBand.push({
        x: base.x + (Math.random()-0.5)*w*0.12,
        y: base.y + (Math.random()-0.5)*h*0.08,
        r: Math.random()*90+50,
        a: Math.random()*0.045+0.018,
        tint: Math.random()>0.55 ? '139,92,246' : (Math.random()>0.3 ? '34,211,238' : '245,200,76'),
        vx: (Math.random()-0.5)*0.025
      });
    }

    // floating embers (foreground layer, original concept kept)
    embers = [];
    const emberCount = Math.min(34, Math.floor(w/32));
    for(let i=0;i<emberCount;i++){
      embers.push({
        x: Math.random()*w, y: Math.random()*h,
        r: Math.random()*1.5+0.5,
        vy: -(Math.random()*0.2+0.04),
        vx: (Math.random()-0.5)*0.1,
        hue: ['139,92,246','34,211,238','245,200,76'][Math.floor(Math.random()*3)],
        a: Math.random()*0.35+0.1
      });
    }
  }
  resize(); initField();
  window.addEventListener('resize', ()=>{ resize(); initField(); });

  function spawnShootingStar(){
    const fromTop = Math.random() > 0.5;
    shootingStar = {
      x: Math.random()*w*0.6 + w*0.1,
      y: fromTop ? -20 : Math.random()*h*0.3,
      vx: (Math.random()*2.2+2.2),
      vy: (Math.random()*1.6+1.4),
      life: 0,
      maxLife: 38 + Math.random()*16
    };
  }
  setInterval(()=>{ if(!shootingStar && Math.random() > 0.4) spawnShootingStar(); }, 5200);

  let t = 0;
  function animate(){
    ctx.clearRect(0,0,w,h);

    // nebula dust clusters — soft, slow, layered glow
    dustBand.forEach(d=>{
      d.x += d.vx;
      const grad = ctx.createRadialGradient(d.x,d.y,0,d.x,d.y,d.r);
      grad.addColorStop(0, `rgba(${d.tint},${d.a})`);
      grad.addColorStop(1, `rgba(${d.tint},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(d.x,d.y,d.r,0,Math.PI*2);
      ctx.fill();
    });

    // distant scatter
    stars.forEach(s=>{
      const tw = s.baseA + Math.sin(t*s.speed*10 + s.phase)*0.22;
      ctx.beginPath();
      ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle = `rgba(${s.tint},${Math.max(0,tw)})`;
      ctx.fill();
    });

    // galaxy band clustered stars — denser, textured streak
    galaxyBand.forEach(s=>{
      const tw = s.baseA + Math.sin(t*s.speed*10 + s.phase)*0.25;
      ctx.beginPath();
      ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle = `rgba(${s.tint},${Math.max(0,tw)})`;
      ctx.fill();
    });

    // bright hero stars with subtle cross-flare
    heroStars.forEach(s=>{
      const tw = s.baseA + Math.sin(t*s.speed*10 + s.phase)*0.3;
      const a = Math.max(0,tw);
      ctx.beginPath();
      ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle = `rgba(${s.tint},${a})`;
      ctx.fill();
      // flare lines
      ctx.strokeStyle = `rgba(${s.tint},${a*0.35})`;
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.moveTo(s.x - s.r*5, s.y); ctx.lineTo(s.x + s.r*5, s.y);
      ctx.moveTo(s.x, s.y - s.r*5); ctx.lineTo(s.x, s.y + s.r*5);
      ctx.stroke();
    });

    // floating embers
    embers.forEach(p=>{
      p.y += p.vy; p.x += p.vx;
      if(p.y < -10) p.y = h+10;
      if(p.x < -10) p.x = w+10; if(p.x > w+10) p.x = -10;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle = `rgba(${p.hue},${p.a})`;
      ctx.fill();
    });

    // shooting star
    if(shootingStar){
      const s = shootingStar;
      s.life++;
      s.x += s.vx; s.y += s.vy;
      const progress = s.life / s.maxLife;
      const fade = progress < 0.15 ? progress/0.15 : (1 - (progress-0.15)/0.85);
      const grad = ctx.createLinearGradient(s.x, s.y, s.x - s.vx*14, s.y - s.vy*14);
      grad.addColorStop(0, `rgba(255,255,255,${0.85*fade})`);
      grad.addColorStop(1, `rgba(255,255,255,0)`);
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(s.x - s.vx*14, s.y - s.vy*14);
      ctx.stroke();
      if(s.life > s.maxLife) shootingStar = null;
    }

    t += 1;
    requestAnimationFrame(animate);
  }
  animate();

  // ---------- scroll progress + nav dots (hero/map only) ----------
  const scrollBar = document.getElementById('scrollBar');
  const topSections = ['hero','map'].map(id=>document.getElementById(id));
  const dots = document.querySelectorAll('.navDot');
  window.addEventListener('scroll', ()=>{
    const st = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    scrollBar.style.width = (max>0 ? st/max*100 : 0)+'%';

    let current = 0;
    topSections.forEach((s,i)=>{ if(st >= s.offsetTop - window.innerHeight*0.4) current = i; });
    dots.forEach((d,i)=> d.classList.toggle('active', i===current));
  });
  dots.forEach(d=>{
    d.addEventListener('click', ()=>{
      document.getElementById(d.dataset.target).scrollIntoView({behavior:'smooth'});
    });
  });

  // ---------- gallery overlay open/close ----------
  function openGallery(id){
    const el = document.getElementById(id);
    el.classList.add('open');
    document.body.classList.add('overlay-open');
    el.scrollTop = 0;
  }
  function closeGallery(id){
    document.getElementById(id).classList.remove('open');
    document.body.classList.remove('overlay-open');
  }
  document.addEventListener('keydown', (e)=>{
    if(e.key === 'Escape'){
      document.querySelectorAll('.gallery-overlay.open').forEach(el=>{
        el.classList.remove('open');
        document.body.classList.remove('overlay-open');
      });
    }
  });

  // ---------- live clock ----------
  function updateClock(){
    const now = new Date();
    const time = now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const date = now.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
    document.getElementById('liveClock').textContent = `${time} · ${date}`;
  }
  updateClock(); setInterval(updateClock,1000);

  // ---------- rotating quote ----------
  const quotes = [
    '"The best museums are the ones still being built."',
    '"Every exhibit was once just an idea worth keeping."',
    '"Curate your life like it deserves a placard."',
    '"Not all collections are made of objects."',
    '"Some rooms you build for others. This one, I built for myself."'
  ];
  document.getElementById('quoteCard').textContent = quotes[Math.floor(Math.random()*quotes.length)];

  // ---------- placard toggle ----------
  function togglePlacard(btn, id){
    const el = document.getElementById(id);
    el.classList.toggle('open');
    btn.classList.toggle('open');
  }

  // ---------- club titles toggle (Sports Pavilion) ----------
  function toggleClub(btn, id){
    const el = document.getElementById(id);
    el.classList.toggle('open');
    btn.classList.toggle('open');
  }

  // ---------- guestbook (preview-only, no persistence) ----------
  function signGuestbook(){
    const input = document.getElementById('guestbookInput');
    const note = document.getElementById('guestbookNote');
    if(input.value.trim().length === 0){
      note.textContent = 'Write something first — then it\'ll be ready to sign.';
      note.style.color = 'var(--gold)';
      return;
    }
    note.textContent = 'Noted! In the full build, this gets saved for real.';
    note.style.color = 'var(--cyan)';
    input.value = '';
  }
</script>

